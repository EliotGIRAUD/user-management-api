    "express": "^5.1.0",
    "mysql2": "^3.15.1",
    "node-fetch": "^3.3.2",
    "reflect-metadata": "^0.2.2",
    "ts-node-dev": "^2.0.0",
    "typeorm": "^0.3.27",
    "typescript": "^5.9.2",
    "uuid": "^13.0.0"
  },
