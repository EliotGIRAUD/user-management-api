{
  "name": "user-management-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/external/server.js",
    "dev": "concurrently \"tsc -p tsconfig.build.json -w\" \"nodemon --watch dist dist/external/server.js\"",
    "dev:accounts": "cd services/account-service && npm run dev",
    "build:accounts": "cd services/account-service && npm run build",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:accounts\"",
    "dev:rmq": "docker run --rm -p 5672:5672 -p 15672:15672 rabbitmq:3-management"
  },
